# Hugging Face token — must have "Inference Providers" permission enabled.
# Generate one at https://huggingface.co/settings/tokens
HF_API_KEY=hf_your_token_here

# Server port (optional, defaults to 3000)
PORT=3000

# Browser origin allowed to call the API (optional)
CORS_ORIGIN=https://hellenicdev.eu

# Cloudflare Turnstile secret (optional). When set, POST /upload requires a token.
# Pair it with TURNSTILE_SITE_KEY in frontend/script.js.
# TURNSTILE_SECRET_KEY=
